{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": [
    "src/**/*.{ts,tsx,css}",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignore": [
    "src/components/ui/**",
    "src/components/guestbook/reply-button.tsx"
  ],
  "ignoreDependencies": [
    "@radix-ui/react-separator",
    "prettier",
    "prettier-plugin-tailwindcss"
  ],
  "rules": {
    "exports": "warn",
    "duplicates": "warn",
    "types": "warn"
  },
  "ignoreExportsUsedInFile": true
}
