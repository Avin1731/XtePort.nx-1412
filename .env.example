# Ganti tulisan di bawah dengan Connection String dari Neon tadi
DATABASE_URL="postgresql://neondb_owner:..............@ep-patient-....." --- IGNORE ---
AUTH_SECRET="................................" # Isi random string apa aja (minimal 32 huruf biar aman)

# Google OAuth
AUTH_GOOGLE_ID="..."
AUTH_GOOGLE_SECRET="..."

# NEXT_PUBLIC_APP_URL untuk konfigurasi URL aplikasi
# saat deploy ke Vercel atau platform lain
# NEXT_PUBLIC_APP_URL="https://..."
# atau saat local
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloud Name (Ada di pojok kiri atas, tulisan putih di kotak biru)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="..."

# Upload Preset (Nama yang kamu buat di tabel)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="..."

# Admin & Email Service (Resend)
ADMIN_EMAIL="your_email@gmail.com"
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@xteonlyone.my.id"